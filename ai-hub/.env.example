# === Slack (OpenClaw Bot Token を再利用) ===
SLACK_BOT_TOKEN=xoxb-your-bot-token

# === Gmail IMAP/SMTP ===
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# === Claude API ===
ANTHROPIC_API_KEY=your-anthropic-api-key

# === Telegram (緊急通知用) ===
